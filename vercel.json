{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "installCommand": "yarn install",
        "buildCommand": "yarn run build:vercel"
      }
    }
  ],
  "framework": null,
  "functions": {
    "pages/api/**/*.js": {
      "maxDuration": 30
    }
  }
}